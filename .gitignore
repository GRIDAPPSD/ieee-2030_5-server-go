# Temporary files
tmp/
*.tmp

# rapid (property-based testing) failure-repro files.
# #214: failures reproduce from the seed logged in test output, not
# from committed files. See plan-4-property-based-testing/plan.md.
testdata/rapid/

# Stress test run artifacts (generated per run; not source)
test/stress/results/

# Stale root-level binary (built during development, now lives in bin/)
/sep2loadgen

# IEEE 2030.5 normative WADL. sep_wadl.xml is copyrighted by IEEE and is NOT
# distributed with this project (see NOTICE). Drop a licensed copy at
# test/conformance/wadl/sep_wadl.xml, or point SEP2_WADL_PATH at one, to run
# the WADL conformance sweep. It must never be committed.
/test/conformance/wadl/*.xml
sep_wadl.xml

# Conformance sweep output (generated per run; a record of a server run, not
# source, and verbose). Written only when SEP2_WADL_SWEEP_OUT is set.
*.jsonl

# Admin UI screenshot capture tooling (tools/capture/capture.js): its
# npm install and generated run outputs, not source.
/tools/capture/node_modules/
/tools/capture/capture-report.json
/tools/capture/scratch/

# Log files
*.log
